{
  "name": "mission-control-site",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-mostly website for the Mission Control workspace",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "check:app": "node tools/check-app.mjs",
    "app": "cd app && tauri dev",
    "build:app": "node tools/build-app.mjs",
    "measure": "node tools/measure.mjs",
    "package": "node tools/package.mjs",
    "check:release": "node tools/check-release.mjs",
    "publish-folder": "node tools/publish.mjs"
  },
  "dependencies": {
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
